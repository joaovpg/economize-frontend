{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "jsx-a11y", "promise", "unicorn"],
  "jsPlugins": ["@shadcn/lint", "oxlint-tailwindcss", "eslint-plugin-sonarjs"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "settings": {
    "shadcn": {
      "componentImports": ["(^|/)components(/|$)"]
    },
    "tailwindcss": {
      "entryPoint": "src/styles/index.css"
    }
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "sonarjs/no-fallthrough": "warn",
    "sonarjs/no-equals-in-for-termination": "warn",
    "sonarjs/no-extra-arguments": "error",
    "sonarjs/no-labels": "warn",
    "sonarjs/no-nested-assignment": "warn",
    "sonarjs/no-redundant-boolean": "warn",
    "sonarjs/no-case-label-in-switch": "warn",
    "sonarjs/no-parameter-reassignment": "error",
    "sonarjs/no-floating-point-equality": "error",
    "sonarjs/no-hardcoded-ip": "warn",
    "sonarjs/label-position": "warn",
    "sonarjs/max-switch-cases": "warn",
    "sonarjs/function-inside-loop": "warn",
    "sonarjs/code-eval": "error",
    "sonarjs/future-reserved-words": "warn",
    "sonarjs/no-primitive-wrappers": "warn",
    "sonarjs/no-identical-expressions": "error",
    "sonarjs/constructor-for-side-effects": "error",
    "sonarjs/no-dead-store": "warn",
    "sonarjs/no-identical-conditions": "error",
    "sonarjs/no-duplicated-branches": "warn",
    "sonarjs/no-inverted-boolean-check": "warn",
    "sonarjs/misplaced-loop-counter": "warn",
    "sonarjs/no-nested-functions": "warn",
    "sonarjs/no-hardcoded-passwords": "error",
    "sonarjs/insecure-cookie": "error",
    "sonarjs/no-useless-increment": "error",
    "sonarjs/no-globals-shadowing": "error",
    "sonarjs/pseudo-random": "error",
    "sonarjs/for-loop-increment-sign": "error",
    "sonarjs/updated-loop-counter": "warn",
    "sonarjs/block-scoped-var": "warn",
    "sonarjs/no-ignored-exceptions": "warn",
    "sonarjs/no-gratuitous-expressions": "warn",
    "sonarjs/no-unenclosed-multiline-block": "warn",
    "sonarjs/no-implicit-global": "warn",
    "sonarjs/no-useless-catch": "warn",
    "sonarjs/non-existent-operator": "error",
    "sonarjs/no-global-this": "warn",
    "sonarjs/no-delete-var": "error",
    "sonarjs/no-nested-conditional": "warn",
    "sonarjs/updated-const-var": "error",
    "sonarjs/no-invariant-returns": "warn",
    "sonarjs/generator-without-yield": "error",
    "sonarjs/comma-or-logical-or-case": "error",
    "sonarjs/no-redundant-jump": "warn",
    "sonarjs/inconsistent-function-call": "warn",
    "sonarjs/no-use-of-empty-return-value": "error",
    "sonarjs/cognitive-complexity": "warn",
    "sonarjs/no-all-duplicated-branches": "error",
    "sonarjs/no-unthrown-error": "error",
    "sonarjs/no-unused-collection": "warn",
    "sonarjs/no-os-command-from-path": "error",
    "sonarjs/no-element-overwrite": "error",
    "sonarjs/no-identical-functions": "error",
    "sonarjs/no-empty-collection": "error",
    "sonarjs/no-redundant-assignments": "warn",
    "sonarjs/prefer-default-last": "warn",
    "sonarjs/no-duplicate-in-composite": "warn",
    "sonarjs/no-nested-template-literals": "warn",
    "sonarjs/link-with-target-blank": "error",
    "sonarjs/table-header": "error",
    "sonarjs/no-table-as-layout": "warn",
    "sonarjs/table-header-reference": "error",
    "sonarjs/object-alt-content": "warn",
    "sonarjs/no-clear-text-protocols": "error",
    "sonarjs/insecure-jwt-token": "error",
    "sonarjs/stateful-regex": "error",
    "sonarjs/no-hardcoded-secrets": "error",
    "sonarjs/hardcoded-secret-signatures": "error",
    "sonarjs/no-hook-setter-in-body": "error",
    "sonarjs/no-useless-react-setstate": "error",
    "sonarjs/no-uniq-key": "warn",
    "sonarjs/redundant-type-aliases": "warn",
    "sonarjs/no-internal-api-use": "warn",
    "sonarjs/no-literal-call": "error",
    "sonarjs/super-linear-regex": "warn",
    "sonarjs/no-debounce-throttle-in-render": "error",
    "sonarjs/avoid-mutating-nested-properties-of-shallow-clones": "warn",
    "typescript/no-deprecated": "warn",
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"]
      }
    ],
    "shadcn/no-raw-colors": [
      "error",
      {
        "allow": [
          "text-display-hero",
          "text-page-title",
          "text-section-title",
          "text-card-title",
          "text-title-compact",
          "text-metric",
          "text-body-large",
          "text-body",
          "text-body-small",
          "text-label",
          "text-button",
          "text-caption",
          "text-caption-strong",
          "text-validation",
          "text-meta",
          "text-code",
          "text-token",
          "shadow-dialog",
          "shadow-popover",
          "shadow-nav-active",
          "shadow-tree-node"
        ]
      }
    ],
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": ["layout"]
      }
    ],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": "warn",
    "shadcn/require-static-classes": "error",
    "eslint/no-unused-vars": "error",
    "no-alert": "error",
    "no-console": "error",
    "no-debugger": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-argument": "warn",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "customHOCs": [
          "createFileRoute",
          "createRootRouteWithContext",
          "createRootRoute",
          "createLink"
        ]
      }
    ],
    "import/no-unassigned-import": "off",
    "import/no-cycle": "error",
    "jsx-a11y/alt-text": "error",
    "promise/no-return-in-finally": "error",
    "tailwindcss/no-unknown-classes": "error",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-deprecated-classes": "error"
  },
  "overrides": [
    {
      "files": ["src/components/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/require-static-classes": "off"
      }
    }
  ],
  "ignorePatterns": ["src/routeTree.gen.ts"]
}
